POLARIS_ENVIRONMENT=staging
POLARIS_AUTH_MODE=supabase
POLARIS_SUPABASE_URL=https://<project-ref>.supabase.co
POLARIS_SUPABASE_AUDIENCE=authenticated
POLARIS_DATABASE_URL=postgresql+psycopg://<runtime-role>:<password>@<database-host>:5432/postgres?sslmode=require
POLARIS_REQUIRE_LOCAL_CAPTURE_LIBRARY=false
